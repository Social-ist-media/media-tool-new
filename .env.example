# Postgres connection. Required in production (Neon or any Postgres).
# Without it the app falls back to an embedded database that does not survive
# on Vercel.
DATABASE_URL=postgres://user:password@host/db

# Long random string. Required so sessions survive a restart.
BETTER_AUTH_SECRET=

# Public origin of this deploy, no trailing slash.
# Example: https://media-tool-new.vercel.app
BETTER_AUTH_URL=
